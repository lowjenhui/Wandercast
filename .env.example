# Free token from https://www.travelpayouts.com (Profile → API token).
# Copy this file to .env.local and fill it in. Never prefix with VITE_.
TRAVELPAYOUTS_TOKEN=

# Optional: live Google Flights prices for exact dates. Free key (250 searches/month) from
# https://serpapi.com/manage-api-key. Searches are saved and reused for 6 hours; the app stops
# calling SerpApi when this month's allowance is used up and shows the saved prices instead.
SERPAPI_KEY=
# SERPAPI_MONTHLY_LIMIT=250

# Currency for all fare requests and prices shown (ISO code). Defaults to SGD.
FARE_CURRENCY=SGD
